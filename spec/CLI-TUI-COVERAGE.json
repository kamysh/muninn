      "Config": {"scope": {"attributes": ["#[command(flatten)]"], "type": "ScopeArgs"}, "op": {"attributes": ["#[command(subcommand)]"], "type": "Option<ConfigOp>"}, "path": {"attributes": ["#[arg(value_name=\"PATH\",conflicts_with=\"ScopeArgs\")]"], "type": "Option<std::path::PathBuf>"}, "json": {"attributes": ["#[arg(long,requires=\"path\")]"], "type": "bool"}, "check": {"attributes": ["#[arg(long,value_name=\"-\",value_parser=[\"-\"],requires=\"json\",conflicts_with=\"apply\")]"], "type": "Option<String>"}, "apply": {"attributes": ["#[arg(long,value_name=\"-\",value_parser=[\"-\"],requires=\"json\")]"], "type": "Option<String>"}},
      "Preflight": {"path": {"attributes": [], "type": "std::path::PathBuf"}, "json": {"attributes": ["#[arg(long,required=true)]"], "type": "bool"}},
      "Add": {"path": {"attributes": [], "type": "std::path::PathBuf"}, "json": {"attributes": ["#[arg(long)]"], "type": "bool"}, "input": {"attributes": ["#[arg(long,value_name=\"-\",value_parser=[\"-\"],requires=\"json\")]"], "type": "Option<String>"}},
      "Start": {"path": {"attributes": [], "type": "std::path::PathBuf"}, "json": {"attributes": ["#[arg(long)]"], "type": "bool"}, "input": {"attributes": ["#[arg(long,value_name=\"-\",value_parser=[\"-\"],requires=\"json\")]"], "type": "Option<String>"}},
      "Reindex": {"path": {"attributes": [], "type": "Option<String>"}, "all": {"attributes": ["#[arg(long,conflicts_with=\"path\")]"], "type": "bool"}, "detach": {"attributes": ["#[arg(long,conflicts_with=\"all\")]"], "type": "bool"}},
      "Pause": {"path": {"attributes": [], "type": "String"}},
      "Resume": {"path": {"attributes": [], "type": "String"}},
      "Remove": {"path": {"attributes": [], "type": "String"}, "yes": {"attributes": ["#[arg(long)]"], "type": "bool"}},
      "Status": {"path": {"attributes": [], "type": "Option<String>"}},
      "Usage": {"days": {"attributes": ["#[arg(long,default_value_t=30)]"], "type": "i64"}}
    },
    "config_operations": {
      "Get": {"key": {"attributes": [], "type": "Option<String>"}},
      "Set": {"assignments": {"attributes": ["#[arg(value_name=\"KEY=VALUE\",required=true)]"], "type": "Vec<String>"}},
      "Edit": {},
      "Unset": {"key": {"attributes": [], "type": "String"}}
    }
  },
  "scope_details": {
    "global": {"attributes": ["#[arg(long,global=true)]"], "type": "bool"}
  }
